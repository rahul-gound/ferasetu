# =============================================================================
# FeraSetu Frontend — Environment Variables Template
# Copy this file to .env.local for local development, or add these to your
# Cloudflare Pages environment variables configuration.
# =============================================================================

# App Identification
VITE_APP_NAME=FeraSetu

# Backend API Endpoint
# - For local development: http://localhost:8787 (Cloudflare Worker local dev)
# - For production: https://ferasetu.singhantima203.workers.dev
VITE_API_URL=https://ferasetu.singhantima203.workers.dev

# WorkOS AuthKit (client ID only; this value is public and must never be an API key)
VITE_WORKOS_CLIENT_ID=client_your_workos_client_id_here

# Clerk Authentication Configuration
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Appwrite Cloud Identity Configuration (Legacy/Storage)
# - Endpoint: https://sgp.cloud.appwrite.io/v1 (or your custom regional Appwrite endpoint)
# - Project ID: 6a267e4a000415bb2cdb
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6a267e4a000415bb2cdb
VITE_APPWRITE_PROJECT_NAME=FeraSetu

# Appwrite Database Settings (Optional / Schema specific)
VITE_APPWRITE_DATABASE_ID=fera
VITE_APPWRITE_USERS_COLLECTION_ID=users

# Domain Routing Configurations
# - Main domain used to check merchant subdomains (e.g. *.fera-search.tech)
VITE_BASE_DOMAIN=ferasetu.com

# Feature Flags & Dev Toggles
# - Set to 'false' to use the live Edge Worker database instead of local storage fallback
VITE_USE_LOCAL_STORAGE=false
VITE_BETA_MODE=true

#authentication 
VITE_CLERK_PUBLISHABLE_KEY=pk_test_dmlhYmxlLWZpcmVmbHktMjUuY2xlcmsuYWNjb3VudHMuZGV2JA

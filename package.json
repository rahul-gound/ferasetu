{
  "name": "fera-shopkeeper",
  "version": "1.0.0",
  "description": "AI-powered e-commerce platform for Indian small retailers",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:worker": "cd worker && npx wrangler dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:legacy:backend": "cd backend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "build:legacy:backend": "cd backend && npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:qa": "node --test tests/qa-control-plane.test.mjs",
    "qa:smoke": "node packages/qa-engine/src/cli.js --mode smoke",
    "qa:full": "node packages/qa-engine/src/cli.js --mode full",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "ecommerce",
    "ai",
    "india",
    "shopkeeper",
    "sarvam",
    "multilingual"
  ],
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-query": "^5.97.0",
    "framer-motion": "^12.40.0",
    "zustand": "4.5.5"
  },
  "overrides": {
    "zustand": "4.5.5"
  }
}
